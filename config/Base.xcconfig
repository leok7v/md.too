// Base.xcconfig -- committed (public + devs).
// Per-developer overrides go in Local.xcconfig (gitignored).
// Local.xcconfig defines LOCAL_DEVELOPMENT_TEAM; if absent, the team
// resolves to empty (matches the public-repo convention).

#include? "Local.xcconfig"
#include "platform.xcconfig"
#include "version.xcconfig"
// version-generated.xcconfig is written by Scripts/stamp-version.sh on
// every build; gitignored. Optional so a fresh checkout builds before
// the first stamp runs (version.xcconfig provides the fallback).
#include? "version-generated.xcconfig"
